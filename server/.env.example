# Copy this file to ".env" in the same folder (server/.env) and adjust as needed.
# All values below are the defaults used if a variable is not set.

# Port the server listens on
PORT=8080

# Network interface to bind to. 0.0.0.0 = all interfaces (required for LAN access).
# Do not change this to 127.0.0.1 or "localhost" or students will not be able to connect.
HOST=0.0.0.0

# development | production
NODE_ENV=development

# error | warn | info | debug
LOG_LEVEL=info

# --- Authentication (Phase 3) ---

# How many hours a login session stays valid without activity (sliding).
SESSION_TTL_HOURS=8

# Name of the browser cookie used to hold the session token.
SESSION_COOKIE_NAME=morse_session

# bcrypt cost factor for password hashing. Higher = slower/more secure.
BCRYPT_COST=11

# Initial teacher/admin account, created automatically the first time the
# server runs (if no teacher account exists yet).
# If INITIAL_TEACHER_PASSWORD is left blank, a random password is generated
# and written ONCE to server/data/INITIAL_TEACHER_CREDENTIALS.txt — open
# that file, log in, then delete it.
# Do NOT commit a real production password into this file.
INITIAL_TEACHER_USERNAME=admin
INITIAL_TEACHER_PASSWORD=
